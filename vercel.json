{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.py?__path__=/metrics"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path__=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path__=/openapi.json"
    }
  ]
}
